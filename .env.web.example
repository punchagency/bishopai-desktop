# Copy to .env.web (or .env) to point a website build at a different backend.
# Unset, it falls back to the hosted Railway backend (see lib/platform.ts) —
# the same default innerlume.config.json ships to the desktop app.
#
# Pointing at a local server during `npm run dev:web`:
# VITE_BACKEND_URL=http://localhost:3000
VITE_BACKEND_URL=
