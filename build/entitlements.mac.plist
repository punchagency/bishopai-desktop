<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron runs V8, which JITs. Under the hardened runtime (required for
       notarization) the app cannot allocate executable memory without this, and
       will crash on launch rather than fail to sign. These two are the only
       runtime entitlements a pure-Electron app needs — there are no native
       modules or bundled child executables to load (the Bee CLI, which once
       required dyld/library-validation exceptions, was retired). -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!-- Talks to the hosted backend over HTTPS. -->
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
